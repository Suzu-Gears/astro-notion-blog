---
import * as interfaces from '../../lib/interfaces.ts'
import Caption from './Caption.astro'

export interface Props {
  block: interfaces.Block
  url: URL
}

const { block, url } = Astro.props

const postURL =
  url.hostname === 'x.com' || url.hostname === 'www.x.com'
    ? new URL(url.pathname, 'https://twitter.com')
    : url
---

<div class="tweet-embed">
  <blockquote class="twitter-tweet">
    <a href={postURL}></a>
  </blockquote>
  <Caption richTexts={block.Embed?.Caption ?? []} />
</div>

<script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>

<style>
  .tweet-embed {
    width: 100%;
    max-width: 640px;
    margin-block: 0.6rem;
    margin-inline: auto;
  }
  .tweet-embed div:first-child div:first-child {
    margin: auto;
  }
</style>

<style is:global>
  .tweet-embed > .twitter-tweet {
    margin-block: 0 !important;
  }
</style>
